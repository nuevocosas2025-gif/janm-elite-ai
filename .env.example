# ==============================================================================
# JANM ELITE AI - CONFIGURACIÓN DE VARIABLES DE ENTORNO (.env.example)
# COPIA ESTE ARCHIVO A .env.local Y COMPLETA LOS VALORES REQUERIDOS
# NOTA: NUNCA COMPARTAS NI SUBAS EL ARCHIVO .env.local A GITHUB
# ==============================================================================

# SUPABASE POSTGRESQL & AUTH
# Requerido: URL de tu proyecto en Supabase (ej: https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Requerido: Clave pública / anon key (segura para exponer en el navegador)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_tu_clave_anonima_aqui

# Opcional / Servidor: Clave de servicio para tareas administrativas críticas
# IMPORTANTE: ¡NUNCA USES ESTA CLAVE EN VARIABLES NEXT_PUBLIC_!
SUPABASE_SERVICE_ROLE_KEY=

# GOOGLE SHEETS INTEGRATION
# ID de la hoja de cálculo de Google (lo encuentras en la URL entre /d/ y /edit)
GOOGLE_SHEETS_ID=
# Nombre de la pestaña de contactos (por defecto: Contactos o CRM)
GOOGLE_SHEETS_TAB_NAME=Contactos
# Credenciales de Service Account o Webhook de Google Apps Script (alternativa gratuita directa)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_APPS_SCRIPT_WEBHOOK_URL=

# MOTOR DE INTELIGENCIA ARTIFICIAL (ARQUITECTURA INTERCAMBIABLE)
# Si no configuras ninguna clave de IA, el sistema activa automáticamente
# el MODO HEURÍSTICO SIN IA (Búsqueda semántica de cursos, FAQs y captura de leads)
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# CONFIGURACIÓN GENERAL DEL SISTEMA
NEXT_PUBLIC_APP_NAME="ORATORIA JANM ELITE AI"
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_CONTACT_WHATSAPP=+51984512345
ACADEMY_PHONE="+51 984 512 345"
ACADEMY_ADDRESS="Av. Principal 123, Chiclayo / Lima, Perú"
